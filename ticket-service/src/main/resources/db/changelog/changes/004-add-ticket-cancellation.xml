<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="15-add-ticket-cancellation" author="event-ticket-platform">
        <addColumn tableName="tickets">
            <column name="cancelled_at" type="TIMESTAMP"/>
            <column name="cancel_reason" type="VARCHAR(50)"/>
            <column name="cancel_note" type="TEXT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
