        <createIndex indexName="IDX_QRTZ_FT_TG" tableName="QRTZ_FIRED_TRIGGERS">
            <column name="SCHED_NAME"/>
            <column name="TRIGGER_GROUP"/>
        </createIndex>
    </changeSet>

    <changeSet id="10-create-qrtz-scheduler-state" author="event-ticket-platform">
